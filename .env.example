# .env.example
# Copy this file to .env and fill in your details

# Local MySQL setup:
# DATABASE_URL="mysql+pymysql://root:YourPassword@localhost:3306/smart_waste_db"

# AWS RDS setup:
# DATABASE_URL="mysql+pymysql://USERNAME:PASSWORD@ENDPOINT:3306/smart_waste_db"

DATABASE_URL="mysql+pymysql://root:password@localhost:3306/smart_waste_db"

# Generate these with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace-with-generated-secret-key"
JWT_SECRET_KEY="replace-with-generated-jwt-secret-key"

